{
  "expo": {
    "name": "FinVault",
    "slug": "expense-tracking-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/finVaultAppIcon.png",
    "scheme": "expensetrackingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F0F8F6",
        "foregroundImage": "./assets/images/finVaultAppIcon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.megajunaid.expensetrackingapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0F8F6",
          "image": "./assets/images/splashLogo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#091413",
            "image": "./assets/images/splashLogo.png"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a9a6f367-5954-48ce-85d4-480ec81d94dc"
      }
    }
  }
}